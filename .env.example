# Public origin of the deployed site, used for canonical URLs, hreflang and sitemap.
NEXT_PUBLIC_SITE_URL=https://sarto-interiors.ch

# Pre-launch gate. When set, the whole site asks for HTTP Basic Auth (user: sarto). Remove at launch.
# SITE_PASSWORD=

# Enquiry delivery (Resend). Without these three values the form reports an error
# and shows the direct email address instead of a false success state.
# RESEND_API_KEY=
# ENQUIRY_TO=contact@sarto-interiors.ch
# ENQUIRY_FROM="SARTO Website <website@sarto-interiors.ch>"
